# Where LewLM is listening. `lewlm serve` defaults to this.
LEWLM_BASE_URL=http://127.0.0.1:8080

# Only needed when LewLM runs with LEWLM_API_KEY_REQUIRED=true.
# The key lives here, in the server process — the browser never sees it.
LEWLM_API_KEY=

# Where DocKtizo is listening. Not used yet; the seam is stubbed.
DOCKTIZO_BASE_URL=http://127.0.0.1:8090

# Port for Chap's own server.
CHAP_PORT=8787

# Where LewLM is listening. `lewlm serve` defaults to this.
LEWLM_BASE_URL=http://127.0.0.1:8080

# Only needed when LewLM runs with LEWLM_API_KEY_REQUIRED=true.
# The key lives here, in the server process — the browser never sees it.
LEWLM_API_KEY=

# Address and port for Chap's own server. Keep the default loopback-only unless
# the API proxy and the installed modules are intentionally being exposed.
CHAP_HOST=127.0.0.1
CHAP_PORT=8787

# Where modules keep state. Chap creates it; each module owns a path inside.
CHAP_DATA_DIR=.chap


# --- modules -----------------------------------------------------------------
# Everything below belongs to a module. Delete the module and these stop being
# read by anything — see docs/modules.md. `/_chap/health` reports which module
# reads which key, so a misconfiguration is findable from the Settings screen.

# @chap/module-collections — Chap's retrieval store.
# Defaults to $CHAP_DATA_DIR/vectors.sqlite; set only to keep an older location.
CHAP_VECTOR_STORE=

# --- companions --------------------------------------------------------------
# Companions are adapters for *other* products built on LewLM, so Chap can be
# used to test them too. Chap needs none of them. Each is off unless named here
# (comma-separated); Settings → modules lists the ones this build carries.
CHAP_COMPANIONS=

# @chap/module-docktizo — only read when CHAP_COMPANIONS includes `docktizo`.
# DocKtizo is a separate, experimental document-generation service built on
# LewLM (github.com/lew-cx/DocKtizo). See packages/module-docktizo/README.md.
DOCKTIZO_BASE_URL=http://127.0.0.1:8090
# The bearer lives here, in the server process, and is injected by the proxy.
# DocKtizo requires at least 32 characters with no whitespace.
DOCKTIZO_TOKEN=
# Only needed when the token grants more than one workspace membership.
DOCKTIZO_WORKSPACE_ID=

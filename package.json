{
  "name": "chap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GUI test bench and showroom for LewLM, and for products built on it",
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/doctor.mjs && node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace @chap/server",
    "dev:web": "npm run dev --workspace @chap/web",
    "build": "npm run build --workspace @chap/web",
    "start": "npm run start --workspace @chap/server",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:gaps": "node scripts/gen-gaps.mjs",
    "loc:budget": "node scripts/loc-budget.mjs",
    "module:check": "node scripts/module-check.mjs",
    "proof": "tsx --env-file-if-exists=.env scripts/proof.ts",
    "proof:docktizo": "tsx --env-file-if-exists=.env packages/module-docktizo/proof.ts",
    "test": "tsx --test packages/lewlm/src/stream.test.ts packages/lewlm/src/events.test.ts packages/module-collections/src/vectors.test.ts web/src/lib/sentences.test.ts web/src/lib/dictation.test.ts",
    "typecheck": "tsc -b --pretty",
    "skin:check": "node scripts/skin-check.mjs",
    "ui:smoke": "node scripts/ui-smoke.mjs",
    "ui:checklist": "node scripts/ui-checklist.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.5.2",
    "playwright": "^1.62.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

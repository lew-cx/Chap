{
  "name": "chap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GUI test bench and showroom for LewLM and DocKtizo",
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace @chap/server",
    "dev:web": "npm run dev --workspace @chap/web",
    "build": "npm run build --workspace @chap/web",
    "start": "npm run start --workspace @chap/server",
    "gen:types": "node scripts/gen-types.mjs",
    "loc:budget": "node scripts/loc-budget.mjs",
    "module:check": "node scripts/module-check.mjs",
    "proof": "tsx scripts/proof.ts",
    "proof:dk": "tsx packages/module-docktizo/proof.ts",
    "test": "tsx --test packages/lewlm/src/stream.test.ts packages/module-collections/src/vectors.test.ts web/src/lib/sentences.test.ts",
    "typecheck": "tsc -b --pretty",
    "skin:check": "node scripts/skin-check.mjs"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.5.2",
    "playwright": "^1.62.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
